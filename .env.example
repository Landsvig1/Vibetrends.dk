# Names only, no values. Copy to .env.local and fill in. Never commit real values.
#
# Cloud sessions and CI need none of the Mac-only groups. Typecheck, lint and
# unit tests run with no env at all; only `npm run build` and the e2e server
# need the BUILD group (CI uses placeholder values for them).

# --- BUILD: needed for `npm run build` and the dev server ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# HMAC salt for hashed IPs in rate limiting. Routes that rate-limit 500 without it.
RATE_LIMIT_IP_SALT=

# --- MAC-ONLY: direct database access ---
# Supabase connection string. Migrations, scripts/review-queue.mjs, the e2e
# seeder and most scripts/*.mjs. Direct host is IPv6-only; see AGENTS.md for the
# pooler fallback. Never put this in a cloud environment.
DATABASE_URL=

# --- MAC-ONLY: service role and server secrets ---
# Bypasses RLS. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer for POST /api/revalidate. Also read by review-queue and publish-hot-ranking.
REVALIDATE_SECRET=
# Bearer for GET /api/internal/hot-sources and scripts/scan-hot-skills.mjs.
HOT_SCAN_SECRET=
# Bearer for /api/cron/security-health (Vercel cron).
CRON_SECRET=
# Healthchecks.io ping base URL used by the security-health cron.
HEALTHCHECK_PING_URL=

# --- MAC-ONLY: bot and owner identity ---
# The curator bot and admin ids are hardcoded in src/lib/permissions.ts, not
# read from env, so there is no bot credential variable. These are the only
# identity inputs the scripts read.
# Comma-separated user ids excluded from analytics.
ANALYTICS_OWNER_USER_IDS=
# User ids that delete-orphan-agent-accounts.mjs must keep.
ORPHAN_CLEANUP_KEEP_IDS=

# --- OPTIONAL: tokens and tooling ---
# GitHub API token (higher rate limit for /api/github-meta and the refresh scripts).
GITHUB_TOKEN=
# Vercel API token for scripts/fetch-user-analytics.mjs.
VERCEL_TOKEN=
# Base URL overrides for scripts. Default https://vibetrends.dk.
SITE_URL=
SITE_ORIGIN=
# Local path override for scripts/generate-analytics-report.mjs.
ANTIGRAVITY_APP_DATA=

# --- GitHub Actions secrets only (not read from .env.local) ---
# SUBMISSION_PR_TOKEN: PAT used by the hot-ranking and submission workflows.
