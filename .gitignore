# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.e2e-fixtures.json

# generated at build from Supabase (scripts/generate-index.js)
/public/semantic-index.json

# next.js
/.next/
/out/

# production
/build
/output

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# working docs, not codebase material
docs/marketing/gtm-90-days.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# impeccable: machine-local hook wiring, detector caches, and per-run output.
# The design system itself — DESIGN.md, PRODUCT.md, .impeccable/design.json —
# is committed.
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/config.local.json
# Timestamped critique reports, one per audited file per run. Read them
# locally, but they accumulate and describe a moment rather than the design
# system, so they don't belong in history.
.impeccable/critique/

# Scratch PR body written by scripts/scan-hot-skills.mjs; never committed.
rankings/skills-hot/.pr-body.md
